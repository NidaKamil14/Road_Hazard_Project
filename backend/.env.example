# Database Configuration (PostgreSQL + PostGIS)
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/road_hazard_db

# Optional: Path to YOLO11s trained weights (defaults to runs/detect/experiment2_yolo11s_800/weights/best.pt)
MODEL_PATH=runs/detect/experiment2_yolo11s_800/weights/best.pt

# OSRM Public Driving Routing Service Base URL
OSRM_BASE_URL=https://router.project-osrm.org
